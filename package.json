{
  "name": "jju-bank-dashboard",
  "version": "3.0.0",
  "description": "JJU Bank Dashboard \u2014 full backend with all DB connections",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "pm2": "pm2 start backend/server.js --name jju-bank",
    "pm2:stop": "pm2 stop jju-bank",
    "pm2:logs": "pm2 logs jju-bank",
    "test": "jest",
    "test:watch": "jest --watch",
    "dev:staging": "cross-env ENV_FILE=.env.staging nodemon backend/server.js",
    "pm2:staging": "cross-env ENV_FILE=.env.staging pm2 start backend/server.js --name jju-bank-staging",
    "pm2:staging:stop": "pm2 stop jju-bank-staging",
    "pm2:staging:logs": "pm2 logs jju-bank-staging",
    "test:legacy": "node --test backend/gold-loan-fixes.test.js",
    "test:all": "npm run test && npm run test:legacy"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^178.1.1",
    "helmet": "^8.2.0",
    "pg": "^8.11.0",
    "puppeteer": "^24.42.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "cross-env": "^7.0.3"
  }
}
