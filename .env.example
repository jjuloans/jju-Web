# Copy this file to .env and fill in real values. .env itself is gitignored
# and should never be committed.

DB_USER=jju_user
DB_HOST=127.0.0.1
DB_NAME=jju_bank
DB_PASSWORD=
DB_PORT=5432

PORT=4001

# development | production — currently only used by errorHandler.js to
# decide whether raw error messages/stack traces are safe to show in an API
# response. Leave unset (defaults to production-safe behavior) unless you
# know you want verbose error output.
NODE_ENV=production
